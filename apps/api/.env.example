ENV=development  # development | test | production
TZ=America/Bogota

# Base de datos (Supabase usado solo como Postgres, ADR-02)
# Runtime: pooler de Supabase (las cachés de prepared statements se desactivan en app/core/db.py)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/fitia_db
# Alembic y seeds: conexión directa (no el pooler)
DATABASE_URL_DIRECT=postgresql+asyncpg://postgres:postgres@localhost:5432/fitia_db
# Solo para pytest
TEST_DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/fitia_test

FRONTEND_BASE_URL=http://localhost:5173

# Autenticación y registro (HU 1)
CONSENT_TEXT_VERSION=2026-01
VERIFICATION_TOKEN_TTL_HOURS=24
SESSION_TTL_DAYS=30  # expiración deslizante por inactividad
SESSION_TOUCH_INTERVAL_MINUTES=10  # cada cuánto se extiende la sesión como máximo
COOKIE_SECURE=false  # true en producción (HTTPS)

# Límites de peticiones en registro y reenvío (por IP y por correo, ventana en segundos)
RATE_LIMIT_WINDOW_SECONDS=900
RATE_LIMIT_PER_IP=30
RATE_LIMIT_PER_EMAIL=5

# Límites del login: por IP cuenta todos los intentos (alto: el campus comparte IP);
# por correo cuenta solo los fallidos y se reinicia tras un login exitoso.
RATE_LIMIT_LOGIN_WINDOW_MINUTES=15
RATE_LIMIT_LOGIN_PER_IP=100
RATE_LIMIT_LOGIN_PER_EMAIL=5

# Correo transaccional (ADR-12). console = imprime el enlace en stdout (solo local).
MAIL_PROVIDER=console  # console | http
MAIL_API_URL=https://api.resend.com/emails
MAIL_API_KEY=
MAIL_FROM=FITIA <no-reply@fitia.univalle.edu.co>

# IA (Gemini, ADR-07). En producción: AI_PROVIDER=gemini y GEMINI_API_KEY obligatoria (si no, la app no arranca).
AI_ENABLED=true
AI_PROVIDER=fake  # fake (local/pruebas) | gemini
GEMINI_API_KEY=
GEMINI_MODEL=  # vacío = el del prompt activo (gemini-3.8-flash); p. ej. gemini-3.8-flash, gemini-3.5-flash
PROMPT_VERSION_WEEKLY_PLAN=v1
AI_TIMEOUT_SECONDS=20  # por intento
AI_TOTAL_BUDGET_SECONDS=40  # incluye el único reintento
AI_RETRY_MIN_REMAINING_SECONDS=5
AI_BREAKER_FAILURES=5
AI_BREAKER_WINDOW_SECONDS=60
AI_BREAKER_OPEN_SECONDS=30

# Plan semanal (HU 5)
PLAN_MAX_GENERATIONS_PER_WEEK=3  # 1 inicial + 2 regeneraciones
PLAN_STALE_SECONDS=90  # generación huérfana (p. ej. reinicio de Render); debe ser > AI_TOTAL_BUDGET_SECONDS
RATE_LIMIT_PLAN_GENERATE_PER_USER=6
RATE_LIMIT_PLAN_GENERATE_WINDOW_MINUTES=60
