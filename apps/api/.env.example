ENV=development  # development | test | production
TZ=America/Bogota

# Base de datos (Supabase usado solo como Postgres, ADR-02)
# Runtime: pooler de Supabase (las cachés de prepared statements se desactivan en app/core/db.py)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/fitia_db
# Alembic y seeds: conexión directa (no el pooler)
DATABASE_URL_DIRECT=postgresql+asyncpg://postgres:postgres@localhost:5432/fitia_db
# Solo para pytest
TEST_DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/fitia_test

FRONTEND_BASE_URL=http://localhost:5173

# Autenticación y registro (HU 1)
CONSENT_TEXT_VERSION=2026-01
VERIFICATION_TOKEN_TTL_HOURS=24
SESSION_TTL_DAYS=30
COOKIE_SECURE=false  # true en producción (HTTPS)

# Límites de peticiones en registro y reenvío (por IP y por correo, ventana en segundos)
RATE_LIMIT_WINDOW_SECONDS=900
RATE_LIMIT_PER_IP=30
RATE_LIMIT_PER_EMAIL=5

# Correo transaccional (ADR-12). console = imprime el enlace en stdout (solo local).
MAIL_PROVIDER=console  # console | http
MAIL_API_URL=https://api.resend.com/emails
MAIL_API_KEY=
MAIL_FROM=FITIA <no-reply@fitia.univalle.edu.co>

# IA (Gemini)
GEMINI_API_KEY=tu_api_key_de_gemini
AI_PROVIDER=fake  # Opciones: fake, gemini
AI_ENABLED=true
