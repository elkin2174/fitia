ENVIRONMENT=development
TZ=America/Bogota

# Base de datos (Supabase / Postgres)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/fitia_db
DIRECT_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/fitia_db

# Seguridad y Sesión (Argon2id / Secret Key)
SECRET_KEY=cambiar_esta_clave_secreta_por_una_cadena_aleatoria_segura_32_bytes
SESSION_EXPIRE_DAYS=30

# IA (Gemini)
GEMINI_API_KEY=tu_api_key_de_gemini
AI_PROVIDER=fake  # Opciones: fake, gemini
AI_ENABLED=true

# Correo Transaccional
MAILER_PROVIDER=console  # Opciones: console, resend, sendgrid
MAILER_API_KEY=
MAILER_FROM=no-reply@fitia.univalle.edu.co
