# Variables de docker compose (copiar a .env; .env está en .gitignore). Todas son opcionales.

# Puertos publicados en el equipo. Los valores por defecto evitan chocar con un Postgres local (5432).
POSTGRES_PORT=5433
API_PORT=8000
WEB_PORT=3000

# Base de datos
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=fitia_db

# IA del plan semanal. fake = sin clave (local y pruebas); gemini = Gemini real.
AI_PROVIDER=fake
AI_ENABLED=true
GEMINI_API_KEY=
GEMINI_MODEL=

# Render MCP / Deployment
RENDER_API_KEY=
